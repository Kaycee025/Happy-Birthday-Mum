# ==============================================================================
# MUM'S KEEPSAKE WEBSITE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file with secrets to Git or public repositories!

# --- 1. SINGLE ADMIN ACCOUNT CREDENTIALS ---
# Username for the single administrator
ADMIN_USERNAME=admin

# Initial password (must be at least 10 characters).
# On first startup, the server automatically hashes this with secure scrypt
# and saves the salt & hash into data/auth.json.
ADMIN_PASSWORD=MumLove2026!

# Fixed administrator recovery email.
# Password resets can ONLY be delivered to this exact address.
# It CANNOT be modified via dashboard or database.
ADMIN_EMAIL=kcee492@gmail.com

# --- 2. SESSION SECURITY ---
# Long random string used to cryptographically sign httpOnly session cookies.
# Change this in production!
SESSION_SECRET=keepsake_secret_key_8f93a1c5d7e2b4f68102

# Server Port (default: 8000)
PORT=8000

# Base URL of the website (used for generating password reset links in emails)
APP_URL=http://localhost:8000

# Environment mode: 'development' or 'production'
# In production, cookies enforce 'Secure; SameSite=Lax'.
NODE_ENV=development

# --- 3. TRANSACTIONAL EMAIL PROVIDER (FOR PASSWORD RESETS) ---
# Supports Resend (recommended - free tier includes 3,000 emails/month).
# Sign up at https://resend.com, generate an API key, and paste below:
RESEND_API_KEY=

# Sender email address
# If using Resend without a custom domain, use: onboarding@resend.dev
EMAIL_FROM=Mum's Keepsake Studio <onboarding@resend.dev>

# Optional SMTP Settings (if you prefer SMTP over Resend):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
