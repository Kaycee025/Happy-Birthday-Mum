{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin/login",
      "destination": "/admin-login.html"
    },
    {
      "source": "/admin/forgot-password",
      "destination": "/admin-forgot-password.html"
    },
    {
      "source": "/admin/reset-password",
      "destination": "/admin-reset-password.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
